{
  "name": "servertest-local-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "bin": { "devflow": "bin/devflow.js" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:all": "node tools/dev-all.js",
    "server": "node server.js",
    "start": "node server.js",
    "target": "node tools/test-target.js",
    "bench": "node tools/run-benchmark.js",
    "bench:ci": "node tools/run-benchmark.js --ci",
    "bench:compare": "node tools/compare-benchmarks.js",
    "bench:baseline": "node tools/run-benchmark.js --ci --save-baseline",
    "bench:campaign": "node tools/run-campaign.js",
    "bench:scaling": "node tools/run-worker-scaling-benchmark.js",
    "soak": "node tools/soak-test.js",
    "soak:ci": "node tools/soak-test.js --ci",
    "bench:cross-validate": "node tools/cross-validate.js",
    "regression:experiment": "node tools/run-regression-experiment.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:validation": "node --test tests/validation/*.test.js",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.66.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autocannon": "^8.0.0",
    "typescript": "^7.0.2"
  }
}
