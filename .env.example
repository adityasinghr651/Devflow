# DevFlow configuration (local development defaults; review before production)
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:4000/api/v1

# In production set a unique random secret of at least 32 characters.
JWT_SECRET=replace_with_a_secure_random_32_char_secret_in_production
JWT_EXPIRES_IN=24h
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
# OAuth apps (optional). Configure real provider credentials before enabling OAuth.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:4000/api/auth/oauth
# OAUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/
# Initial admin bootstrap: set a unique strong password only in your private environment.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# PostgreSQL is optional locally. When omitted, JSON storage is used.
# DATABASE_URL=postgresql://devflow:password@127.0.0.1:5432/devflow
DB_POOL_MIN=2
DB_POOL_MAX=10
DATA_DIR=./data

# Runner limits
MAX_ACTIVE_RUNS=1
MAX_DURATION_SEC=30
MAX_RUNS_STORED_PER_USER=1000
MAX_ACTIVE_RUNS_PER_USER=3
MAX_RUNS_PER_DAY=100
PAID_RUN_QUOTA=10000
MAX_VU_SECONDS_PER_DAY=36000
REQUEST_TIMEOUT_MS=5000
WORKER_STARTUP_TIMEOUT_MS=30000
WORKER_NO_PROGRESS_TIMEOUT_MS=15000
WORKER_MEMORY_MB=512
RUNNER_ENGINE=auto
# K6_BIN=k6

# Compose only
# POSTGRES_PASSWORD=replace_with_a_long_random_password
