# ServerTest Configuration

# Server & Network
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:4000/api

# Security & Permissions
ALLOW_LOCAL_TARGETS=true
JWT_SECRET=replace_with_a_secure_random_32_char_secret_in_production
JWT_EXPIRES_IN=24h
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Database Persistence (PostgreSQL)
# When set, ServerTest connects to PostgreSQL and runs version-controlled migrations automatically.
# When omitted, ServerTest falls back to isolated multi-user local JSON storage in DATA_DIR.
# DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/servertest
DB_POOL_MIN=2
DB_POOL_MAX=10

# Storage fallback directory
DATA_DIR=./data

# Runner & Worker limits
MAX_ACTIVE_RUNS=1
REQUEST_TIMEOUT_MS=5000
# K6_BIN=k6
