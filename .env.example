# Local development configuration. Copy this file to .env and replace the placeholders.
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:4000/api/v1

# Auth. Generate a fresh value (at least 32 random characters) for production.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=24h
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Optional OAuth. Leave blank to disable the provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:4000/api/auth/oauth
OAUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/

# One-time initial admin bootstrap; set only while running the bootstrap command.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Storage. Unset DATABASE_URL to use the zero-setup JSON file store in ./data.
# For local/Docker Postgres, DB_SSL=false is correct.
DATABASE_URL=
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DATA_DIR=./data
# For Supabase/managed Postgres, set DATABASE_URL to its connection URI and DB_SSL=true.
# See docs/DATABASE_SETUP.md. Production example: .env.production.example

# Optional Supabase Auth for email/password registration and sign-in.
# The publishable key is safe for app use; the backend uses it only to call Supabase Auth.
# DevFlow permissions (roles, plan, target/run ownership) remain in its own user records.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Razorpay Standard Checkout (server-side credentials only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Pro price in INR. The server converts this to paise for Razorpay Orders.
UPGRADE_PLAN_PRICE_INR=199
# Legacy alternative, used only when UPGRADE_PLAN_PRICE_INR is unset: amount in paise.
# RAZORPAY_PRO_AMOUNT_PAISE=
# Reserved for a future webhook endpoint; current checkout does not consume this value.
# RAZORPAY_WEBHOOK_SECRET=

# Runner and load-test limits
ALLOW_LOCAL_TARGETS=true
MAX_ACTIVE_RUNS=1
MAX_DURATION_SEC=30
MAX_RUNS_STORED_PER_USER=1000
MAX_ACTIVE_RUNS_PER_USER=3
MAX_RUNS_PER_DAY=100
PAID_RUN_QUOTA=10000
MAX_VU_SECONDS_PER_DAY=36000
REQUEST_TIMEOUT_MS=5000
WORKER_STARTUP_TIMEOUT_MS=30000
WORKER_NO_PROGRESS_TIMEOUT_MS=15000
WORKER_MEMORY_MB=512
RUNNER_ENGINE=auto
# K6_BIN=k6

# Docker Compose only: set a unique database password.
# POSTGRES_PASSWORD=replace_with_a_long_random_password

# Production deployment overrides (set actual domains; don't use placeholder hosts):
# NODE_ENV=production
# API_HOST=0.0.0.0
# CORS_ORIGIN=https://your-frontend-domain.example
# VITE_API_URL=https://your-backend-domain.example/api/v1
# ALLOW_LOCAL_TARGETS=false
