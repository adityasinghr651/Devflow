# Copy to a private production .env or, preferably, configure each value in the deployment secret manager.
# Never commit a real .env file. Replace every placeholder before starting in production.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=https://your-real-frontend-domain.example
VITE_API_URL=https://your-real-backend-domain.example/api/v1
ALLOW_LOCAL_TARGETS=false

# Supabase PostgreSQL: use the exact direct or session-pooler URI from the Supabase dashboard.
# Replace with the rotated database password; URL-encode reserved characters.
DATABASE_URL=postgresql://postgres:<ROTATED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10
DATA_DIR=./data

# Generate a unique value of at least 32 random characters for this deployment.
JWT_SECRET=<GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
JWT_EXPIRES_IN=24h
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Optional OAuth; add actual provider credentials only when OAuth is configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://your-real-backend-domain.example/api/auth/oauth
OAUTH_FRONTEND_SUCCESS_URL=https://your-real-frontend-domain.example/

# Optional one-time initial admin bootstrap. Set only for the bootstrap command, then remove.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Razorpay production credentials belong only on the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPGRADE_PLAN_PRICE_INR=199
# Reserved for a future webhook endpoint; current checkout does not use a webhook secret.
# RAZORPAY_WEBHOOK_SECRET=

# Runner limits
MAX_ACTIVE_RUNS=1
MAX_DURATION_SEC=30
MAX_RUNS_STORED_PER_USER=1000
MAX_ACTIVE_RUNS_PER_USER=3
MAX_RUNS_PER_DAY=100
PAID_RUN_QUOTA=10000
MAX_VU_SECONDS_PER_DAY=36000
REQUEST_TIMEOUT_MS=5000
WORKER_STARTUP_TIMEOUT_MS=30000
WORKER_NO_PROGRESS_TIMEOUT_MS=15000
WORKER_MEMORY_MB=512
RUNNER_ENGINE=auto
# K6_BIN=/usr/local/bin/k6
